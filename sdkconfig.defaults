# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# 频谱柱从 32 根减到 16 根之后重新评估过这个值。ESP32-C3 无 PSRAM,DRAM
# 是硬约束:实测 LV_MEM_SIZE=32KB 时 UI 正常,但 MP3 解码器初始化直接返回
# ESP_ERR_NO_MEM(串口日志 'Fail to init MP3 decoder ret 10'),音频只剩断续
# 残帧。解码器要的是几十 KB 连续内存,和 UI 池直接竞争。
# 所以这里取能建起全部对象的下限,而不是越大越保险 —— UI 侧的余量必须
# 让给解码器。tools/sim/lv_conf.h 跟着用同样大小,改一处就要改另一处。
CONFIG_LV_MEM_SIZE=32768
# 中文界面:UTF-8 编码 + 缺字占位(缺字必须可见,不得静默空白)。
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_USE_FONT_PLACEHOLDER=y

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- 网络与 TLS ---
# mbedTLS 证书包:校验 open.bigmodel.cn 证书链(随 IDF 内置根证书)。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# 流媒体 TLS 内存画像(对齐参考固件的实测值):16KB 收包缓冲会在
# https+解码并发时挤爆堆,压到 8KB;发包 4KB 够音频流使用。
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# https+解码并发三件套:不保留对端证书(省 2-3KB)、缓冲按协商结果收缩、
# 流媒体不需要重协商。没有这些,TLS 上下文在播放中分配失败(-0x7F00)。
# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y
# CONFIG_MBEDTLS_SSL_RENEGOTIATION is not set
# SNTP 对时(TLS 校验需要正确墙钟),两个服务器互备。
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# --- Bluetooth ---
# 本应用(GLM 用量宝)不使用 BLE,关闭以节省约 25KB 内部 RAM 给 WiFi+TLS。
# 若要编译参考 demo_ble.c,请恢复以下 NimBLE 配置(见基线 git 历史)。
# CONFIG_BT_ENABLED is not set

# FAT 文件分区已拆(2026-10-04):清单=台目 rodata + 自定义台 NVS,
# files 分区保留在分区表里但不再使用(避免改布局,分段刷机兼容旧机)。

# --- 配网二维码(设置→配网页展示 WiFi/管理地址二维码) ---
CONFIG_LV_USE_QRCODE=y
# 框架全量中文字库(4333 字)的 24px 位图 >1MB,超过 LVGL 20 位 bitmap_index,
# 必须用 32 位索引(LV_FONT_FMT_TXT_LARGE);见 components/framework/appfw/fonts/。
CONFIG_LV_FONT_FMT_TXT_LARGE=y
